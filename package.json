{
  "name": "completion-booster",
  "displayName": "Completion Booster",
  "description": "为snippets添加数字标注，支持快速选择",
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.60.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished",
    "onLanguage:*",
    "onCommand:completionBooster.enable"
  ],
  "main": "./src/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "completionBooster.enable",
        "title": "启用 Completion Booster"
      },
      {
        "command": "completionBooster.insertNumberedSnippet",
        "title": "插入带序号的代码片段"
      }
    ],
    "configuration": {
      "title": "Completion Booster",
      "properties": {
        "completionBooster.enabled": {
          "type": "boolean",
          "default": true,
          "description": "是否启用snippets数字标注功能"
        }
      }
    },
    "keybindings": [
      {
        "command": "completionBooster.insertNumberedSnippet",
        "key": "0",
        "when": "editorTextFocus && suggestWidgetVisible && !completionBooster.isWaitingForSecondDigit",
        "args": {
          "text": "0"
        }
      },
      {
        "command": "completionBooster.insertNumberedSnippet",
        "key": "1",
        "when": "editorTextFocus && suggestWidgetVisible && !completionBooster.isWaitingForSecondDigit",
        "args": {
          "text": "1"
        }
      },
      {
        "command": "completionBooster.insertNumberedSnippet",
        "key": "2",
        "when": "editorTextFocus && suggestWidgetVisible && !completionBooster.isWaitingForSecondDigit",
        "args": {
          "text": "2"
        }
      },
      {
        "command": "completionBooster.insertNumberedSnippet",
        "key": "3",
        "when": "editorTextFocus && suggestWidgetVisible && !completionBooster.isWaitingForSecondDigit",
        "args": {
          "text": "3"
        }
      },
      {
        "command": "completionBooster.insertNumberedSnippet",
        "key": "4",
        "when": "editorTextFocus && suggestWidgetVisible && !completionBooster.isWaitingForSecondDigit",
        "args": {
          "text": "4"
        }
      },
      {
        "command": "completionBooster.insertNumberedSnippet",
        "key": "5",
        "when": "editorTextFocus && suggestWidgetVisible && !completionBooster.isWaitingForSecondDigit",
        "args": {
          "text": "5"
        }
      },
      {
        "command": "completionBooster.insertNumberedSnippet",
        "key": "6",
        "when": "editorTextFocus && suggestWidgetVisible && !completionBooster.isWaitingForSecondDigit",
        "args": {
          "text": "6"
        }
      },
      {
        "command": "completionBooster.insertNumberedSnippet",
        "key": "7",
        "when": "editorTextFocus && suggestWidgetVisible && !completionBooster.isWaitingForSecondDigit",
        "args": {
          "text": "7"
        }
      },
      {
        "command": "completionBooster.insertNumberedSnippet",
        "key": "8",
        "when": "editorTextFocus && suggestWidgetVisible && !completionBooster.isWaitingForSecondDigit",
        "args": {
          "text": "8"
        }
      },
      {
        "command": "completionBooster.insertNumberedSnippet",
        "key": "9",
        "when": "editorTextFocus && suggestWidgetVisible && !completionBooster.isWaitingForSecondDigit",
        "args": {
          "text": "9"
        }
      }
    ]
  },
  "scripts": {
    "debug": "nodemon --watch src --exec \"code --extensionDevelopmentPath=%cd% --disable-extensions --new-window\"",
    "debug:mac": "nodemon --watch src --exec \"code --disable-extensions --extensionDevelopmentPath=${PWD} --enable-proposed-api\"",
    "vscode:prepublish": "echo 'No build needed'"
  },
  "devDependencies": {
    "@types/vscode": "^1.60.0"
  },
  "dependencies": {
    "jsonc-parser": "^3.3.1"
  }
}
